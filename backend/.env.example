# Copy to backend/.env and fill in. Never commit backend/.env.

# TomTom API key (developer.tomtom.com, free tier, no card)
TOMTOM_API_KEY=

# Weather host override: point at the Cloudflare Worker proxy (see
# ops/weather-proxy/) when Open-Meteo rate-limits the free host for this IP.
# OPEN_METEO_BASE_URL=https://weather-proxy.<account>.workers.dev

# Alternative: Open-Meteo API key (customer-api host; free by email for
# non-commercial projects, or paid Standard). Ignored when the base URL above
# is set.
# OPEN_METEO_API_KEY=

# Local dev
DJANGO_DEBUG=1

# Production (Render)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=weather-aware-truck-routing.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://weather-aware-truck-routing.onrender.com
